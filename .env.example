# Copy this to .env and fill in your keys
# At minimum, provide ONE of the following:
OPENAI_API_KEY=sk-proj-sample
GOOGLE_API_KEY=sample
ANTHROPIC_API_KEY=...

# Which provider to use: openai | google | anthropic
LLM_PROVIDER=openai

# Model name (defaults if blank):
# openai  -> gpt-4o-mini
# google  -> gemini-1.5-flash
# anthropic -> claude-3-haiku-20240307
LLM_MODEL=gpt-4o-mini

# Token budget per ForgeAI run (approximate)
TOKEN_BUDGET=200000
